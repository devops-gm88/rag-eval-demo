# Local Postgres 16 + pgvector. Point PG_BIN at the pg_ctl/initdb directory.
PG_BIN=/opt/homebrew/opt/postgresql@16/bin
PGPORT=55432
PGDATABASE=rag_eval
DATABASE_URL=postgresql://127.0.0.1:55432/rag_eval

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:7b

# Where the source documents live. `make corpus` reads this tree.
# RAG_SOURCE_ROOT=/path/to/your/documents
